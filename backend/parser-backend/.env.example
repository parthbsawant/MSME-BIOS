ANTHROPIC_API_KEY=your-api-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/msme_bios

# ---- Per-parser AI vision toggles ----
# Each one independently controls whether that parser's AI escalation
# path is allowed to run. All default to false if unset. Only flip one
# on once that parser's AI path is actually approved and ready - having
# the code built (see bank_parser/ai_extractor.py) does not mean it's
# safe to enable yet.
ENABLE_CLAUDE_VISION_BANK=false
ENABLE_CLAUDE_VISION_INVOICE=false
ENABLE_CLAUDE_VISION_HANDWRITTEN=false
