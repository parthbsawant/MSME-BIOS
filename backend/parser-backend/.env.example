ANTHROPIC_API_KEY=your-api-key-here
# Laptops: the shared DEV database (msme_bios_dev), never production.
DATABASE_URL=postgresql://user:password@host/msme_bios_dev?sslmode=require
# pytest only (tests/conftest.py). Database name must contain "test".
TEST_DATABASE_URL=postgresql://user:password@host/msme_bios_test?sslmode=require

# ---- Firebase Admin (firebase_auth.py) ----
# Path to a Firebase service account JSON credential. Save the real
# file OUTSIDE this repo entirely (e.g. ~/secrets/...), never inside
# backend/parser-backend/. Note the KEY=value form below - a bare path
# with no variable name on its own line does nothing at all.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/your-firebase-adminsdk.json

# ---- API server (api.py) ----
FRONTEND_URL=http://localhost:5173

# ---- Per-parser AI vision toggles ----
ENABLE_CLAUDE_VISION_BANK=false
ENABLE_CLAUDE_VISION_INVOICE=false
ENABLE_CLAUDE_VISION_HANDWRITTEN=false